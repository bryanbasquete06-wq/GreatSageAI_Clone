# Great Sage AI — Chaves de API (NUNCA commite este arquivo)
# Copie para .env e preencha os valores
# TODOS sao gratuitos — nenhum cartao de credito necessario

# === PROVIDERS GRATUITOS (pegue chaves em cada site) ===

# Groq (gratuito, recomendado) — https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini (gratuito, fallback) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Cerebras (gratuito, ultra-rapido) — https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# DeepSeek (gratuito com registro) — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# SambaNova (gratuito, rapido) — https://cloud.sambanova.ai
SAMBANOVA_API_KEY=

# Mistral (gratuito, La Plateforme) — https://console.mistral.ai
MISTRAL_API_KEY=

# Together AI ($25 creditos gratis) — https://api.together.xyz
TOGETHER_API_KEY=

# Fireworks AI (creditos gratis) — https://fireworks.ai
FIREWORKS_API_KEY=

# OpenRouter (modelos gratuitos) — https://openrouter.ai
OPENROUTER_API_KEY=

# Cohere (gratuito) — https://dashboard.cohere.com
COHERE_API_KEY=
