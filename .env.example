# ═══════════════════════════════════════════════════════════════════
# Elívea — Template de Chaves de API
# ═══════════════════════════════════════════════════════════════════
# Copie para .env e preencha os valores
# TODOS são gratuitos — NENHUM cartão de crédito necessário!
#
# Estratégia: Preencha quantas chaves quiser. Mais chaves = mais
# tokens por dia. O router inteligente distribui automaticamente.
#
# Capacidade total com todas as chaves preenchidas:
#   - ~130+ RPM combinados
#   - ~1.5M+ tokens/dia
#   - ~15,000+ requests/dia
# ═══════════════════════════════════════════════════════════════════

# ── TIER 1: PRIORITÁRIO (pegue essas primeiro) ──

# Groq — Ultra-rápido (LPU hardware), 30 RPM, 1000 RPD
# Pegue em: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — Mais generoso, contexto 1M tokens, 1500 RPD
# Pegue em: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Cerebras — 1M tokens/dia, 5 RPM, sem card
# Pegue em: https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# ── TIER 2: ALTAMENTE RECOMENDADO ──

# OpenRouter — 20+ modelos gratuitos, 20 RPM
# Pegue em: https://openrouter.ai
OPENROUTER_API_KEY=

# Mistral — Free mode ativo, 500K TPM, bom para código
# Pegue em: https://console.mistral.ai
MISTRAL_API_KEY=

# NVIDIA NIM — 100+ modelos, 40 RPM, 10K RPD
# Pegue em: https://build.nvidia.com
NVIDIA_API_KEY=

# ── TIER 3: BONUS (mais capacidade) ──

# Cloudflare Workers AI — 75+ modelos, 10K neurons/dia
# Pegue em: https://dash.cloudflare.com → AI → API Tokens
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# SiliconFlow — 1000 RPM, Qwen free
# Pegue em: https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=

# Kilo Code — Auto-router, 200 req/hr
# Pegue em: https://kilo.ai
KILO_API_KEY=

# Hugging Face — Rate-limited free
# Pegue em: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=

# ── TIER 4: LOCAL (ilimitado) ──

# Ollama — Rode modelos locais, tokens ilimitados
# Instale em: https://ollama.com
# Não precisa de API key, só precisa estar rodando
# OLLAMA_MODEL=llama3.1:8b

# ── CONFIGURAÇÕES OPCIONAIS ──

# Modelo específico por provider (opcional — o router escolhe o melhor)
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash
# CEREBRAS_MODEL=gpt-oss-120b
# MISTRAL_MODEL=codestral-latest

# router behavior
# ROUTER_MAX_ATTEMPTS=5
# ROUTER_TIMEOUT=60
